{
	"name": "jodit-plugin-shortlink",
	"version": "1.0.0",
	"description": "Jodit editor plugin that shortens links with da.gd, clck.ru, cleanuri.com or your own service, from the link form and the link toolbar",
	"keywords": [
		"jodit",
		"jodit-plugin",
		"link",
		"url",
		"shortener",
		"short link",
		"da.gd",
		"clck.ru",
		"wysiwyg",
		"editor"
	],
	"homepage": "https://timurseyidov.github.io/jodit-plugins/plugins/shortlink/",
	"bugs": {
		"url": "https://github.com/TimurSeyidov/jodit-plugins/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TimurSeyidov/jodit-plugins.git",
		"directory": "packages/shortlink"
	},
	"author": "Timur Seiidov",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.mjs",
	"module": "./dist/index.mjs",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.mjs"
		},
		"./browser": "./dist/es2021/plugins/shortlink/shortlink.min.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"CHANGELOG.md"
	],
	"scripts": {
		"prepublishOnly": "node ../../tools/build.mjs shortlink"
	},
	"sideEffects": true,
	"jsdelivr": "./dist/es2021/plugins/shortlink/shortlink.min.js",
	"unpkg": "./dist/es2021/plugins/shortlink/shortlink.min.js",
	"peerDependencies": {
		"jodit": "^4.0.0"
	},
	"docs": {
		"order": [
			"installation.md",
			"options.md",
			"examples.md"
		]
	}
}
